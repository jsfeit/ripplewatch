# Supabase — https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — never expose to the client, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# From the Stripe CLI or the dashboard's webhook endpoint settings
STRIPE_WEBHOOK_SECRET=
# Price IDs from https://dashboard.stripe.com/products — one per self-serve tier
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PLUS=

# Comma-separated list of emails allowed into /admin
ADMIN_EMAILS=

# Anthropic — https://console.anthropic.com/settings/keys — powers relevance scoring
ANTHROPIC_API_KEY=

# Resend — https://resend.com/api-keys — powers digest/notification emails
RESEND_API_KEY=
# General sender (welcome, invites, campaigns, billing) — verified domain in Resend, e.g. hello@ripplewatch.ai
RESEND_FROM_EMAIL=
# Alert sender (scored digest emails + uptime health checks) — falls back to RESEND_FROM_EMAIL if unset
RESEND_ALERTS_FROM_EMAIL=

# Slack app — https://api.slack.com/apps — Connect a workspace to deliver alerts
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# HubSpot app — https://developers.hubspot.com/ — CRM read-only integration
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=

# Gong app — https://app.gong.io/settings/api/documentation — competitor
# mentions pulled from sales call transcripts
GONG_CLIENT_ID=
GONG_CLIENT_SECRET=

# Zoom app (OAuth, general app type) — https://marketplace.zoom.us/ —
# competitor mentions pulled from cloud recording transcripts
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Set this to your local/prod origin so OAuth callbacks redirect correctly,
# e.g. http://localhost:3000 in dev or https://ripplewatch.ai in production
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret the cron route checks for on every invocation, so only Vercel Cron
# (or you, manually, with this value) can trigger a crawl. Any random string.
CRON_SECRET=

# ---------------------------------------------------------------------------
# Everything below is optional or a feature switch. Leaving one unset turns
# that feature off (or uses the default noted), it doesn't break the app.
# Set these in Vercel, for Production and Preview (staging) as needed.
# ---------------------------------------------------------------------------

# AI assistant connection (MCP)
# Set to 1 to advertise Supabase directly as the OAuth server instead of
# Ripplewatch's own root-level discovery. Only a rollback switch: Claude's
# connector needs the root-level discovery, so leave it unset.
MCP_OAUTH_DISCOVERY_ON_SUPABASE=
# Token OpenAI's plugin dashboard shows for domain verification. Served as plain
# text at /.well-known/openai-apps-challenge. Unset means that URL returns 404.
OPENAI_APPS_CHALLENGE_TOKEN=

# Deal history by email
# Signing secret for Resend's inbound-email webhook (the winloss+<id>@ address).
RESEND_INBOUND_WEBHOOK_SECRET=
# Set to 1 to accept only the signed address (winloss+<id>.<token>@...) and
# reject the older unsigned one. Unset accepts both.
WINLOSS_REQUIRE_TOKEN=

# Billing (Stripe price ids; the ids differ between test and live mode)
# The $29 a month Ripplewatch Connect platform fee.
STRIPE_PRICE_CONNECT=
# Annual price for the Plus (dashboard) plan.
STRIPE_PRICE_PLUS_ANNUAL=
# Legacy: the Starter plan was removed, only the status check still reads this.
STRIPE_PRICE_STARTER_ANNUAL=
# Set to true to actually apply referral rewards. The referral cron runs in
# review mode (changes nothing) until this is true.
REFERRAL_REWARDS_LIVE=

# Competitor data sources
# Set to true to also run paid web-search news checks per competitor. Off by
# default because every search costs real money.
ENABLE_WEB_SEARCH_NEWS=
# Raises GitHub's rate limit for the competitor GitHub-activity signal.
GITHUB_TOKEN=
# Meta Ad Library API token, for competitor ad activity.
META_AD_LIBRARY_ACCESS_TOKEN=
# Reddit API app, for Reddit and Hacker News mentions.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# ScreenshotOne key, for visual-change checks on competitor pages (Plus plan).
SCREENSHOTONE_ACCESS_KEY=

# Integrations
# Intercom OAuth app, for the Intercom connection (Plus plan).
INTERCOM_CLIENT_ID=
INTERCOM_CLIENT_SECRET=

# Analytics and tracking (all loaded only after a visitor accepts cookies)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
NEXT_PUBLIC_LINKEDIN_CONVERSION_SIGNUP=
NEXT_PUBLIC_LINKEDIN_CONVERSION_LEAD=
NEXT_PUBLIC_LINKEDIN_CONVERSION_CHECKOUT=
NEXT_PUBLIC_LINKEDIN_CONVERSION_PURCHASE=
# Apollo website visitor tracker id, marketing pages only. Set in production only so dev and staging stay out of the data.
NEXT_PUBLIC_APOLLO_TRACKER_ID=
# Rewardful affiliate tracking (public key).
NEXT_PUBLIC_REWARDFUL_API_KEY=
# Sentry error reporting (browser).
NEXT_PUBLIC_SENTRY_DSN=

# Scripts only (not used by the running app)
# Parallel site lookups when enriching cold-email leads. Defaults to 5.
ENRICH_CONCURRENCY=
